# ─── Hamshifo UZ — environment variables ───────────────────────────────
# Copy to .env.local for local development. NEVER commit real values.

# Public base URL of the app (no trailing slash). Used for OAuth redirect URIs and Origin checks.
APP_URL=http://localhost:3000

# Postgres connection string (Supabase "Transaction pooler" URI, Neon pooled URI, or local).
# Local dev with `npm run db:local`: postgres://hamshifo_app:hamshifo_app@127.0.0.1:54329/hamshifo
DATABASE_URL=postgres://hamshifo_app:hamshifo_app@127.0.0.1:54329/hamshifo
# Set to "require" for hosted Postgres (Supabase/Neon). Leave empty for local.
DATABASE_SSL=

# Random 32+ byte secret used to sign OAuth state / demo cookies and salt IP hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (Web application client). Authorized redirect URI:
#   ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API (server-side only — never exposed to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Global safety cap on AI calls per UTC day (cost circuit breaker)
AI_DAILY_LIMIT=3000

# Demo mode: one-click demo patient / demo doctor logins. Set to "false" to disable.
DEMO_MODE=true

# Secret for the daily maintenance cron (/api/cron/maintain). Vercel sends it as a Bearer token.
CRON_SECRET=

# Development only: stream canned AI answers instead of calling the API (ignored in production).
AI_MOCK=
